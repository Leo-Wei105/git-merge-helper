# VS Code相关文件
.vscode/**
.vscode-test/**
.vscodeignore

# 源代码文件（编译后的out目录已包含）
src/**
**/*.ts
**/*.map

# 构建和开发工具
tsconfig.json
**/.eslintrc.json
.gitignore
.yarnrc

# 文档文件（保留README.md和CHANGELOG.md中文版，排除英文副本）
BUILD.md
USAGE.md
README_OTHER.md
IMPROVEMENTS.md
SUMMARY.md
README.en.md
CHANGELOG.en.md

# 开发辅助脚本（i18n生成、检测等，运行时不需要）
check-mojibake.js
check-zh.js
gen-l10n.js
i18n-extract.json
i18n-pkg.js
transform-i18n.js
unescape.js
update-docs.js

# 脚本文件（开发时使用）
scripts/**

# 依赖管理文件
package-lock.json
node_modules/**

# Git相关
.git/**

# 已生成的VSIX包文件
*.vsix

# 临时文件
temp_vsix/**
temp.zip

# macOS系统文件
.DS_Store

# 其他开发文件
vsc-extension-quickstart.md