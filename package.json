{
  "name": "git-workflow-helper",
  "displayName": "Git工作流助手",
  "description": "Git 工作流：规范分支、引导合并、格式化提交（Conventional Commits）、冲突处理、批量 cherry-pick、merge 回滚与 force-with-lease。",
  "version": "0.2.1",
  "publisher": "Leo-Wei105",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leo-Wei105/git-workflow-helper.git"
  },
  "icon": "icons/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:scm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git工作流助手",
      "properties": {
        "gitWorkflowHelper.targetBranches": {
          "type": "array",
          "default": [
            "uat",
            "pre"
          ],
          "items": {
            "type": "string"
          },
          "description": "可选的目标分支列表，支持自定义添加更多分支。例如：`[\"uat\", \"pre\", \"prod\"]`",
          "markdownDescription": "可选的目标分支列表，支持自定义添加更多分支\n\n示例：`[\"uat\", \"pre\", \"prod\"]`\n\n可以直接在设置页面中添加、删除和编辑项"
        },
        "gitWorkflowHelper.branchPrefixes": {
          "type": "array",
          "default": [
            "feature",
            "feat",
            "bugfix",
            "hotfix",
            "fix"
          ],
          "items": {
            "type": "string"
          },
          "description": "分支前缀配置，用于创建标准化命名的分支。例如：`[\"feature\", \"bugfix\", \"hotfix\"]`",
          "markdownDescription": "分支前缀配置，用于创建标准化命名的分支\n\n示例：`[\"feature\", \"bugfix\", \"hotfix\"]`\n\n可以直接在设置页面中添加、删除和编辑项"
        },
        "gitWorkflowHelper.customGitName": {
          "type": "string",
          "default": "",
          "description": "自定义Git用户名（留空则使用Git配置），用于分支命名"
        },
        "gitWorkflowHelper.dateFormat": {
          "type": "string",
          "default": "yyyyMMdd",
          "description": "分支命名中的日期格式",
          "enum": [
            "yyyyMMdd",
            "yyyy-MM-dd",
            "yyMMdd"
          ]
        },
        "gitWorkflowHelper.branchNameFormat": {
          "type": "string",
          "default": "{prefix}/{date}/{description}_{username}",
          "description": "自定义分支名称模板。仅在“分支命名模板预设”选择“自定义模板”时生效。支持占位符：{prefix}、{date}、{description}、{username}"
        },
        "gitWorkflowHelper.branchNameTemplatePreset": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "gitflow",
            "date-first",
            "username-first",
            "release",
            "ticket-like",
            "custom"
          ],
          "enumItemLabels": [
            "默认模板：{prefix}/{date}/{description}_{username}",
            "GitFlow：{prefix}/{description}",
            "日期优先：{date}/{prefix}/{description}",
            "用户名优先：{username}/{prefix}/{description}",
            "发布模板：release/{date}/{description}",
            "单号风格：{prefix}/{description}-{username}",
            "自定义模板（使用 branchNameFormat）"
          ],
          "description": "分支命名模板预设，可在设置中快捷选择"
        },
        "gitWorkflowHelper.autoCheckout": {
          "type": "boolean",
          "default": true,
          "description": "创建分支后自动切换到新分支"
        },
        "gitWorkflowHelper.maxConflictFilesToOpen": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "合并冲突时批量打开文件的最大数量（1-20）"
        },
        "gitWorkflowHelper.skipHooksOnRevert": {
          "type": "boolean",
          "default": false,
          "description": "使用 revert 回滚时，是否始终跳过 pre-commit 等 Git 钩子（--no-verify）"
        },
        "gitWorkflowHelper.maxCherryPickCommitsToList": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "批量优选时列表展示的最多提交数量（10-200）"
        },
        "gitWorkflowHelper.cherryPickRecordOrigin": {
          "type": "boolean",
          "default": true,
          "description": "批量 cherry-pick 时使用 -x 在提交信息中记录来源"
        },
        "gitWorkflowHelper.cherryPickFilterPriority": {
          "type": "array",
          "default": [
            "merge",
            "author",
            "time",
            "keyword"
          ],
          "items": {
            "type": "string",
            "enum": [
              "merge",
              "author",
              "time",
              "keyword"
            ]
          },
          "description": "高级：merge/author/time 过滤的应用顺序。关键字在提交列表顶栏搜索框输入，无需配置"
        },
        "gitWorkflowHelper.mergeRollbackStrategy": {
          "type": "string",
          "default": "reset",
          "enum": [
            "reset",
            "revert",
            "ask"
          ],
          "enumDescriptions": [
            "git reset --hard 到 merge 前（仅当 merge 为分支最新提交时可用，不新增 revert 提交）",
            "git revert -m 1 生成反向提交（保留历史，适合 merge 之后还有提交或已推送）",
            "每次回滚前询问选择 reset 或 revert"
          ],
          "description": "回滚「合入当前分支的合并」时采用的方式（默认 reset，非 revert）"
        },
        "gitWorkflowHelper.commitTemplates": {
          "type": "array",
          "default": [],
          "description": "自定义提交信息模板。可为字符串（如 \"ci: {description}\"）或对象（id、name、description、template）",
          "markdownDescription": "自定义提交信息模板，与内置 Conventional Commits 模板一起出现在「格式化提交」中。\n\n- 字符串：`\"ci: {description}\"`\n- 对象：`{ \"id\": \"ci\", \"name\": \"CI\", \"template\": \"ci: {description}\" }`\n\n占位符：`{description}`、`{scope}`、`{ticket}`、`{username}`",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "template": {
                    "type": "string"
                  }
                },
                "required": [
                  "template"
                ]
              }
            ]
          }
        },
        "gitWorkflowHelper.defaultCommitTemplateId": {
          "type": "string",
          "default": "feat",
          "description": "格式化提交时默认高亮的模板 id（内置如 feat、fix；或自定义模板的 id）"
        }
      }
    },
    "commands": [
      {
        "command": "gitWorkflowHelper.createBranch",
        "title": "创建功能分支",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.mergeFeatureBranch",
        "title": "合并功能分支",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.rollbackLastMerge",
        "title": "回滚合入当前分支的合并",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.showBranchBase",
        "title": "查看当前分支基分支",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.pushForceWithLease",
        "title": "强制推送（force-with-lease）",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.resolveConflicts",
        "title": "处理 Git 冲突",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.batchCherryPick",
        "title": "批量 Cherry-pick（优选）",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.formattedCommit",
        "title": "格式化提交",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.copyFormattedCommitMessage",
        "title": "复制格式化提交信息",
        "category": "Git工作流助手"
      },
      {
        "command": "gitWorkflowHelper.manageConfiguration",
        "title": "配置管理",
        "category": "Git工作流助手"
      }
    ],
    "submenus": [
      {
        "id": "gitWorkflowHelper.context",
        "label": "Git工作流助手"
      }
    ],
    "keybindings": [
      {
        "command": "gitWorkflowHelper.createBranch",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "gitWorkflowHelper.mergeFeatureBranch",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m",
        "when": "gitOpenRepositoryCount > 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitWorkflowHelper.createBranch",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.copyFormattedCommitMessage",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "scm/title": [
        {
          "command": "gitWorkflowHelper.createBranch",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0"
        }
      ],
      "editor/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0 && resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0 && resourceScheme == file"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "gitWorkflowHelper.context": [
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "group": "0_commit@0"
        },
        {
          "command": "gitWorkflowHelper.copyFormattedCommitMessage",
          "group": "0_commit@1"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "group": "0_conflict@0"
        },
        {
          "command": "gitWorkflowHelper.createBranch",
          "group": "1_branch@1"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "group": "2_merge@2"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "group": "2_cherry@2"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "group": "3_rollback@3"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "group": "4_info@4"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "group": "5_push@5"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "group": "9_config@9"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "clean": "rimraf out *.vsix",
    "prepublishOnly": "npm run clean && npm run build",
    "package": "npm run build && vsce package",
    "publish": "npm run build && vsce publish",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "package:patch": "npm version patch --no-git-tag-version && npm run package",
    "package:minor": "npm version minor --no-git-tag-version && npm run package",
    "package:major": "npm version major --no-git-tag-version && npm run package",
    "publish:patch": "npm run build && vsce publish patch",
    "publish:minor": "npm run build && vsce publish minor",
    "publish:major": "npm run build && vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "git",
    "merge",
    "branch",
    "workflow",
    "conventional commits",
    "commit message",
    "cherry-pick",
    "conflict",
    "scm"
  ],
  "author": "",
  "license": "MIT"
}
