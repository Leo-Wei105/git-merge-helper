{
  "name": "git-workflow-helper",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.5.2",
  "publisher": "Leo-Wei105",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leo-Wei105/git-workflow-helper.git"
  },
  "icon": "icons/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:scm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "%config.title.25%",
      "properties": {
        "gitWorkflowHelper.targetBranches": {
          "type": "array",
          "default": [
            "uat",
            "pre"
          ],
          "items": {
            "type": "string"
          },
          "description": "%config.properties.gitWorkflowHelper.targetBranches.description.26%",
          "markdownDescription": "%config.properties.gitWorkflowHelper.targetBranches.markdownDescription.27%"
        },
        "gitWorkflowHelper.branchPrefixes": {
          "type": "array",
          "default": [
            "feature",
            "feat",
            "bugfix",
            "hotfix",
            "fix"
          ],
          "items": {
            "type": "string"
          },
          "description": "%config.properties.gitWorkflowHelper.branchPrefixes.description.28%",
          "markdownDescription": "%config.properties.gitWorkflowHelper.branchPrefixes.markdownDescription.29%"
        },
        "gitWorkflowHelper.customGitName": {
          "type": "string",
          "default": "",
          "description": "%config.properties.gitWorkflowHelper.customGitName.description.30%"
        },
        "gitWorkflowHelper.dateFormat": {
          "type": "string",
          "default": "yyyyMMdd",
          "description": "%config.properties.gitWorkflowHelper.dateFormat.description.31%",
          "enum": [
            "yyyyMMdd",
            "yyyy-MM-dd",
            "yyMMdd"
          ]
        },
        "gitWorkflowHelper.branchNameFormat": {
          "type": "string",
          "default": "{prefix}/{date}/{description}_{username}",
          "description": "%config.properties.gitWorkflowHelper.branchNameFormat.description.32%"
        },
        "gitWorkflowHelper.branchNameTemplatePreset": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "gitflow",
            "date-first",
            "username-first",
            "release",
            "ticket-like",
            "custom"
          ],
          "enumItemLabels": [
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.0.33%",
            "GitFlow：{prefix}/{description}",
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.2.34%",
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.3.35%",
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.4.36%",
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.5.37%",
            "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.enumItemLabels.6.38%"
          ],
          "description": "%config.properties.gitWorkflowHelper.branchNameTemplatePreset.description.39%"
        },
        "gitWorkflowHelper.autoCheckout": {
          "type": "boolean",
          "default": true,
          "description": "%config.properties.gitWorkflowHelper.autoCheckout.description.40%"
        },
        "gitWorkflowHelper.maxConflictFilesToOpen": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.properties.gitWorkflowHelper.maxConflictFilesToOpen.description.41%"
        },
        "gitWorkflowHelper.skipHooksOnRevert": {
          "type": "boolean",
          "default": false,
          "description": "%config.properties.gitWorkflowHelper.skipHooksOnRevert.description.42%"
        },
        "gitWorkflowHelper.maxCherryPickCommitsToList": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "%config.properties.gitWorkflowHelper.maxCherryPickCommitsToList.description.43%"
        },
        "gitWorkflowHelper.cherryPickRecordOrigin": {
          "type": "boolean",
          "default": true,
          "description": "%config.properties.gitWorkflowHelper.cherryPickRecordOrigin.description.44%"
        },
        "gitWorkflowHelper.cherryPickFilterPriority": {
          "type": "array",
          "default": [
            "merge",
            "author",
            "time",
            "keyword"
          ],
          "items": {
            "type": "string",
            "enum": [
              "merge",
              "author",
              "time",
              "keyword"
            ]
          },
          "description": "%config.properties.gitWorkflowHelper.cherryPickFilterPriority.description.45%"
        },
        "gitWorkflowHelper.mergeRollbackStrategy": {
          "type": "string",
          "default": "reset",
          "enum": [
            "reset",
            "revert",
            "ask"
          ],
          "enumDescriptions": [
            "%config.properties.gitWorkflowHelper.mergeRollbackStrategy.enumDescriptions.0.46%",
            "%config.properties.gitWorkflowHelper.mergeRollbackStrategy.enumDescriptions.1.47%",
            "%config.properties.gitWorkflowHelper.mergeRollbackStrategy.enumDescriptions.2.48%"
          ],
          "description": "%config.properties.gitWorkflowHelper.mergeRollbackStrategy.description.49%"
        },
        "gitWorkflowHelper.commitTemplates": {
          "type": "array",
          "default": [],
          "description": "%config.properties.gitWorkflowHelper.commitTemplates.description.50%",
          "markdownDescription": "%config.properties.gitWorkflowHelper.commitTemplates.markdownDescription.51%",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "template": {
                    "type": "string"
                  }
                },
                "required": [
                  "template"
                ]
              }
            ]
          }
        },
        "gitWorkflowHelper.defaultCommitTemplateId": {
          "type": "string",
          "default": "feat",
          "description": "%config.properties.gitWorkflowHelper.defaultCommitTemplateId.description.52%"
        }
      }
    },
    "commands": [
      {
        "command": "gitWorkflowHelper.pullAllBranches",
        "title": "%command.0.title.1%",
        "category": "%command.0.category.2%"
      },
      {
        "command": "gitWorkflowHelper.createBranch",
        "title": "%command.1.title.3%",
        "category": "%command.1.category.4%"
      },
      {
        "command": "gitWorkflowHelper.mergeFeatureBranch",
        "title": "%command.2.title.5%",
        "category": "%command.2.category.6%"
      },
      {
        "command": "gitWorkflowHelper.rollbackLastMerge",
        "title": "%command.3.title.7%",
        "category": "%command.3.category.8%"
      },
      {
        "command": "gitWorkflowHelper.showBranchBase",
        "title": "%command.4.title.9%",
        "category": "%command.4.category.10%"
      },
      {
        "command": "gitWorkflowHelper.pushForceWithLease",
        "title": "%command.5.title.11%",
        "category": "%command.5.category.12%"
      },
      {
        "command": "gitWorkflowHelper.resolveConflicts",
        "title": "%command.6.title.13%",
        "category": "%command.6.category.14%"
      },
      {
        "command": "gitWorkflowHelper.batchCherryPick",
        "title": "%command.7.title.15%",
        "category": "%command.7.category.16%"
      },
      {
        "command": "gitWorkflowHelper.formattedCommit",
        "title": "%command.8.title.17%",
        "category": "%command.8.category.18%"
      },
      {
        "command": "gitWorkflowHelper.copyFormattedCommitMessage",
        "title": "%command.9.title.19%",
        "category": "%command.9.category.20%"
      },
      {
        "command": "gitWorkflowHelper.manageConfiguration",
        "title": "%command.10.title.21%",
        "category": "%command.10.category.22%"
      },
      {
        "command": "gitWorkflowHelper.manageGlobalGitConfig",
        "title": "%command.11.title.23%",
        "category": "%command.11.category.24%"
      }
    ],
    "submenus": [
      {
        "id": "gitWorkflowHelper.context",
        "label": "%submenu.0.label.53%"
      }
    ],
    "keybindings": [
      {
        "command": "gitWorkflowHelper.createBranch",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "gitWorkflowHelper.mergeFeatureBranch",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m",
        "when": "gitOpenRepositoryCount > 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitWorkflowHelper.pullAllBranches",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.createBranch",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.copyFormattedCommitMessage",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitWorkflowHelper.manageGlobalGitConfig",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "scm/title": [
        {
          "command": "gitWorkflowHelper.pullAllBranches",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.createBranch",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "group": "inline",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0"
        }
      ],
      "editor/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0 && resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "gitOpenRepositoryCount > 0 && resourceScheme == file"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "submenu": "gitWorkflowHelper.context",
          "group": "gitWorkflowHelper@7",
          "when": "scmProvider == git && gitOpenRepositoryCount > 0"
        }
      ],
      "gitWorkflowHelper.context": [
        {
          "command": "gitWorkflowHelper.formattedCommit",
          "group": "0_commit@0"
        },
        {
          "command": "gitWorkflowHelper.copyFormattedCommitMessage",
          "group": "0_commit@1"
        },
        {
          "command": "gitWorkflowHelper.resolveConflicts",
          "group": "0_conflict@0"
        },
        {
          "command": "gitWorkflowHelper.createBranch",
          "group": "1_branch@1"
        },
        {
          "command": "gitWorkflowHelper.mergeFeatureBranch",
          "group": "2_merge@2"
        },
        {
          "command": "gitWorkflowHelper.pullAllBranches",
          "group": "2_pull@0"
        },
        {
          "command": "gitWorkflowHelper.batchCherryPick",
          "group": "2_cherry@2"
        },
        {
          "command": "gitWorkflowHelper.rollbackLastMerge",
          "group": "3_rollback@3"
        },
        {
          "command": "gitWorkflowHelper.showBranchBase",
          "group": "4_info@4"
        },
        {
          "command": "gitWorkflowHelper.pushForceWithLease",
          "group": "5_push@5"
        },
        {
          "command": "gitWorkflowHelper.manageConfiguration",
          "group": "9_config@9"
        },
        {
          "command": "gitWorkflowHelper.manageGlobalGitConfig",
          "group": "9_config@8"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "clean": "rimraf out *.vsix",
    "prepublishOnly": "npm run clean && npm run build",
    "package": "npm run build && vsce package",
    "publish": "npm run build && vsce publish",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "package:patch": "npm version patch --no-git-tag-version && npm run package",
    "package:minor": "npm version minor --no-git-tag-version && npm run package",
    "package:major": "npm version major --no-git-tag-version && npm run package",
    "publish:patch": "npm run build && vsce publish patch",
    "publish:minor": "npm run build && vsce publish minor",
    "publish:major": "npm run build && vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "git",
    "merge",
    "branch",
    "workflow",
    "conventional commits",
    "commit message",
    "cherry-pick",
    "conflict",
    "scm"
  ],
  "author": "",
  "license": "MIT",
  "l10n": "./l10n"
}
